<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dominant surface base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/allAppsSurfaceHighest" />
            <corners android:radius="@dimen/rounded_button_radius" />
        </shape>
    </item>
    <!-- Dynamic Material You Multi-Directional Rainbow Overlay with Edge Stroke -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="?attr/searchRainbowStart"
                android:centerColor="?attr/searchRainbowCenter"
                android:endColor="?attr/searchRainbowEnd"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="?attr/searchRainbowStroke" />
            <corners android:radius="@dimen/rounded_button_radius" />
        </shape>
    </item>
</layer-list>
