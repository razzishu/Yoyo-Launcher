<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_ripple_color">
    <item>
        <layer-list>
            <!-- Translucent surface container -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/settings_card_bg_translucent" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <!-- Subtle ambient diagonal sheen with hairline border -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:startColor="@color/rainbow_allapps_start_light"
                        android:centerColor="@color/rainbow_allapps_center_light"
                        android:endColor="@color/rainbow_allapps_end_light"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/settings_card_stroke" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
