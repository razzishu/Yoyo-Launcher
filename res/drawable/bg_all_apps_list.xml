<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dominant surface base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/allAppsListColor" />
            <corners android:radius="@dimen/all_apps_list_corner_radius" />
        </shape>
    </item>
    <!-- Dynamic Material You Multi-Directional Rainbow Overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="?attr/allAppsRainbowStart"
                android:centerColor="?attr/allAppsRainbowCenter"
                android:endColor="?attr/allAppsRainbowEnd"
                android:type="linear" />
            <corners android:radius="@dimen/all_apps_list_corner_radius" />
        </shape>
    </item>
</layer-list>
