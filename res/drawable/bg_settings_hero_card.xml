<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base surface container -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/materialColorSurfaceContainerLow" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Vibrant Material You ambient gradient wash -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/rainbow_suggestions_start_light"
                android:centerColor="@color/rainbow_suggestions_center_light"
                android:endColor="@color/rainbow_suggestions_end_light"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_card_stroke" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
